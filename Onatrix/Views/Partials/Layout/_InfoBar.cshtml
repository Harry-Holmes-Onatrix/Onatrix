@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    var rootContent = Umbraco.ContentAtRoot();
    var siteSettings = rootContent.OfType<SiteSettings>().FirstOrDefault();

    var address = siteSettings?.ContactAddress ?? "Ingen adress just nu, kom tillbaka snart!";
}

<div>
    <div>
        <p>@address</p>
        <div>
            @if (siteSettings?.PlatformList != null)
            {
                foreach (var item in siteSettings.PlatformList)
                {
                    if(item.Content is SocialMediaItem smItem)
                    {
                        switch (smItem.PlatformName!.ToLower())
                        {
                            case "facebook":
                                <a href="@smItem.PlatformAccountUrl" target="_blank">
                                    <i class="fa-brands fa-facebook"></i>
                                </a>
                            break;

                            case "x":
                                <a href="@smItem.PlatformAccountUrl" target="_blank">
                                    <i class="fa-brands fa-x-twitter"></i>
                                </a>
                            break;

                            case "linkedin":
                                <a href="@smItem.PlatformAccountUrl" target="_blank">
                                    <i class="fa-brands fa-linkedin"></i>
                                </a>
                            break;
                        }
                    }
                }
            }
        </div>
    </div>
</div>