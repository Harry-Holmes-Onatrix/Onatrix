@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Onatrix.ViewModels


@{
    var content = (ContentModels.OnlineSupportSection)Model.Content;
    var formVM = new OnlineSupportViewModel();
}

<section class="bg-primary rounded-md relative mb-5">
    <div class="flex flex-col items-center justify-center">
        <img src="/Images/bg-mail-aside.svg" class="absolute bottom-0 right-0 z-0"/>
        <div class="flex flex-col px-6 py-4 gap-4 relative z-10">
            <p class="text-accent text-[1.375rem] font-semibold mx-auto">@content.OnlineSupportTitle</p>
            <p class="text-neutral text-[.875rem]">@content.OnlineSupportBody</p>
            <partial name="Partials/Forms/_OnlineSupportForm" model="formVM" />

        </div>
    </div>
</section>

@if (TempData["SupportFormSuccess"] != null)
{
    <div class="bg-green-50 text-green-700 p-4 mx-[2rem] mb-4 rounded-md">
        @TempData["SupportFormSuccess"]
    </div>
}
else if (TempData["SupportFormError"] != null)
{
    <div class="bg-red-50 text-red-700 p-4 mx-[2rem] mb-4 rounded-md">
        @TempData["SupportFormError"]
    </div>
}