@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content = (ContentModels.ConstructionSection)Model.Content;
}

<div class="flex flex-col items-center gap-10">
    <div class="rte">
        @Html.Raw(content.ConstructionBody)
    </div>

    @if (content.ConstructionLink != null)
    {
        <a class="bg-primary text-white py-3 px-10 no-underline rounded cursor-pointer text-bold" href="@content.ConstructionLink.Url">@content.ConstructionLink.Name</a>
    }
</div>