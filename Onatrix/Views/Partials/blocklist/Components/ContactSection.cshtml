@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var rootContent = Umbraco.ContentAtRoot();

    var content = (ContentModels.ContactSection)Model.Content;
    var settings = rootContent.OfType<SiteSettings>().FirstOrDefault();

    var contactAddress = settings?.ContactAddress ?? "No address available";
    var contactPhone = settings?.ContactPhone ?? "No phone number available";
    var contactEmail = settings?.ContactEmail ?? "No email address available";
}

<section class="pt-10">
    <div class="max-w-7xl mx-auto px-4 flex items-center gap-8">
        <div class="relative w-1/2 min-h-[676px]">
            <img src="/Images/Contact-back.svg" alt="back" class="absolute w-full h-full z-0 top-2.5" />
            <img src="/Images/Contact-top.svg" alt="top" class="absolute w-full h-full z-10 right-12" />
        </div>
        <div class="w-1/2 max-w-[25rem]">
            <p>@content.ContactTitle</p>
            <p>@content.ContactLocationTitle</p>
            <p>@contactAddress</p>
            <p>@content.ContactPhoneTitle</p>
            <p>@contactPhone</p>
            <p>@content.ContactEmailTitle</p>
            <p>@contactEmail</p>
        </div>
    </div>
</section>