@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Onatrix.ViewModels

@{
    var content = (ContentModels.ContactCallbackSection)Model.Content;
    var settings = Model.Settings as ContentModels.AboutCallbackSettings;

    var formVM = new CallbackFormViewModel
    {
        Options = settings?.CallbackRequestOptions ?? []
    };
}

<section class="relative mb-20">
    @if (content.ContactCallbackBackgroundImage != null)
    {
        <img src="@content.ContactCallbackBackgroundImage.Url()" class="z-0" />
    }
    <div class="absolute z-10 h-[35rem] w-[73rem] rounded bg-neutral -bottom-26 left-1/2 -translate-x-1/2 shadow-md">
        <div class="flex flex-col items-center justify-center gap-5 pt-20">
            <p class="text-[.875rem] text-secondary font-bold">@content.ContactCallbackLabel</p>
            <h1 class="text-[2.5rem] text-primary font-bold">@content.ContactCallbackTitle</h1>
            <div class="rte max-w-[40rem]">
                @Html.Raw(content.ContactCallbackBody)
            </div>
            <partial name="Partials/Forms/_ContactCallbackForm" model="formVM" />

            @if (TempData["FormSuccess"] != null)
            {
                <div class="bg-green-50 text-green-700 p-4 mx-[2rem] mb-4 rounded-md">
                    @TempData["FormSuccess"]
                </div>
            }
            else if (TempData["FormError"] != null)
            {
                <div class="bg-red-50 text-red-700 p-4 mx-[2rem] mb-4 rounded-md">
                    @TempData["FormError"]
                </div>
            }
        </div>
    </div>
</section>