@using Onatrix.ViewModels
@model CallbackFormViewModel

@using (Html.BeginUmbracoForm("HandleCallbackForm", "Form", FormMethod.Post, new { novalidate = "novalidate", id = "callbackForm" }))
{
    <div class="">
        <div>
            <label asp-for="Name" class="sr-only"></label>
            <input asp-for="Name" type="text" placeholder="@Html.DisplayNameFor(x => x.Name)" class="" />
            <span asp-validation-for="Name"></span>
        </div>

        <div>
            <label asp-for="Email" class="sr-only"></label>
            <input asp-for="Email" type="text" placeholder="@Html.DisplayNameFor(x => x.Email)" class="" />
            <span asp-validation-for="Email"></span>
        </div>

        <div>
            <label asp-for="Phone" class="sr-only"></label>
            <input asp-for="Phone" type="text" placeholder="@Html.DisplayNameFor(x => x.Phone)" class="" />
            <span asp-validation-for="Phone"></span>
        </div>

        <div>
            <label asp-for="SelectedOption" class="sr-only"></label>
            <div class="relative">
                <select asp-for="SelectedOption" class="">
                    <option value="" disabled hidden selected>Please select an option</option>

                    @foreach (var o in Model.Options)
                    {
                        <option value="@o">@o</option>
                    }
                </select>

                <span class="">
                    <i class="fa-solid fa-chevron-down"></i>
                </span>
            </div>

            <span asp-validation-for="SelectedOption"></span>
        </div>

        <div class="pb-[2.5rem]">
            <button type="submit" class="form-btn">Submit</button>
        </div>
    </div>
}