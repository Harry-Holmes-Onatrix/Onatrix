@using Onatrix.ViewModels
@model CallbackFormViewModel

@using (Html.BeginUmbracoForm("HandleCallbackForm", "Form", FormMethod.Post, new { novalidate = "novalidate", id = "callbackForm" }))
{
    <div class="flex flex-col gap-5">
        <div class="flex gap-5">
            <div>
                <label asp-for="Name" class="sr-only"></label>
                <input asp-for="Name" type="text" placeholder="@Html.DisplayNameFor(x => x.Name)" class="w-[30rem] p-3 italic border border-gray-300 focus:ring-2 focus:ring-primary focus:outline-none" />
                <span asp-validation-for="Name"></span>
            </div>

            <div>
                <label asp-for="Email" class="sr-only"></label>
                <input asp-for="Email" type="text" placeholder="@Html.DisplayNameFor(x => x.Email)" class="w-[30rem] p-3 italic border border-gray-300 focus:ring-2 focus:ring-primary focus:outline-none" />
                <span asp-validation-for="Email"></span>
            </div>
        </div>

        <div class="flex gap-5">
            <div>
                <label asp-for="Phone" class="sr-only"></label>
                <input asp-for="Phone" type="text" placeholder="@Html.DisplayNameFor(x => x.Phone)" class="w-[30rem] p-3 italic border border-gray-300 focus:ring-2 focus:ring-primary focus:outline-none" />
                <span asp-validation-for="Phone"></span>
            </div>

            <div>
                <label asp-for="SelectedOption" class="sr-only"></label>
                <div class="relative">
                    <select asp-for="SelectedOption" class="appearance-none w-[30rem] p-3 pr-10 border border-gray-300 focus:ring-2 focus:ring-primary focus:outline-none">
                        <option value="" disabled hidden selected>Please select an option</option>

                        @foreach (var o in Model.Options)
                        {
                            <option value="@o">@o</option>
                        }
                    </select>

                    <span class="pointer-events-none absolute right-3 inset-y-0 flex items-center">
                        <i class="fa-solid fa-chevron-down"></i>
                    </span>
                </div>

                <span asp-validation-for="SelectedOption"></span>
            </div>
        </div>

        <div>
            <button type="submit" class="contact-form-btn">Submit</button>
        </div>
    </div>
}