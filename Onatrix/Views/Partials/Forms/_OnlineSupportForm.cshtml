@using Onatrix.ViewModels
@model OnlineSupportViewModel

@using (Html.BeginUmbracoForm("HandleOnlineSupportRequest", "Form", FormMethod.Post, new { novalidate = "novalidate", id = "supportForm" }))
{
    <div class="flex justify-center items-center border border-gray-300 bg-neutral rounded-md mb-5 relative">
        <div>
            <label asp-for="Email" class="sr-only"></label>
            <input asp-for="Email" type="text" placeholder="@Html.DisplayNameFor(x => x.Email)" class="w-full py-3 italic focus:ring-primary focus:outline-none" />
        </div>

        <div>
            <button type="submit" class="support-btn"><i class="fa-regular fa-envelope"></i></button>
        </div>
    </div>
    <span asp-validation-for="Email" class="absolute bottom-3 left-7"></span>
}